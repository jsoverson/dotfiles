#!/usr/bin/env nu

def main [] {
  let staged_diff = (git diff --staged)
  let base_url = ($env.OPENROUTER_BASE_URL? | default 'https://openrouter.ai/api/v1' | str trim --right --char '/')
  let model = ($env.OPENROUTER_MODEL? | default 'anthropic/claude-haiku-4.5')
  let prompt = "create a concise commit message from this diff. Use lowercase. Use conventional commits. Use no more than three bullet points (represented as '-' dashes). Only include comments for genuinely important logic changes. Output only the final message suitable for passing to `git commit -m 'MESSAGE'`."

  let response = (http post
    --content-type application/json
    --headers { Authorization: $'Bearer ($env.OPENROUTER_API_KEY)' }
    $'($base_url)/chat/completions'
    {
      model: $model
      messages: [
        { role: system, content: $prompt }
        { role: user, content: $staged_diff }
      ]
    })

  # strip leading and trailing whitespace from the message and fence blocks if they exist
  let message = ($response.choices.0.message.content | str trim | str replace -amr '(:?^```|```$)' '' | str trim)

  print ([{"Generated commit message": $message}] | table -i false)

  git commit -m $message

  # print instructions on how to undo the commit if the message is not good
  print ""
  print "⚠️ If you want to undo this commit, run `git reset --soft HEAD~1`"
}

